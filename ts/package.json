{
  "name": "@mountos-io/native-sdk",
  "version": "0.1.0",
  "description": "Node.js client for the mountOS native filesystem API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "mkdir -p src/gen && protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/gen --ts_proto_opt=outputServices=none,esModuleInterop=true,useOptionals=messages,forceLong=bigint,importSuffix=.js,env=node,outputJsonMethods=false,outputPartialMethods=false,outputClientImpl=false -I ../api/proto ../api/proto/mountos_fs.proto",
    "gen:stubs": "cd ../gen && go run . -spec ../api/filesystem.yaml -client ../api/client.yaml -snapshot ../api/contract-snapshot.json -ts-out ../ts/src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/client.test.js dist/test/bulk_watch.test.js dist/test/notices.test.js dist/test/reconnect.test.js dist/test/socketpath.test.js dist/test/pool.test.js dist/test/hostile.test.js dist/test/frame_fuzz.test.js dist/test/pipeline.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-proto": "^2.13.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  }
}
