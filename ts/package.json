{
  "name": "@mountos-io/native-sdk",
  "version": "0.4.0",
  "description": "Node.js client for the mountOS native filesystem API. Talk to a mounted mountOS volume (a POSIX filesystem over S3, Azure Blob or Google Cloud Storage) over a local Unix socket, without FUSE.",
  "keywords": [
    "mountos",
    "filesystem",
    "posix",
    "unix-socket",
    "fuse",
    "object-storage",
    "s3",
    "azure-blob",
    "gcs",
    "sdk",
    "native-api",
    "file-api"
  ],
  "homepage": "https://mountos.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mountos-io/mountos-native-sdk.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/mountos-io/mountos-native-sdk/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "mkdir -p src/gen && protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/gen --ts_proto_opt=outputServices=none,esModuleInterop=true,useOptionals=messages,forceLong=bigint,importSuffix=.js,env=node,outputJsonMethods=false,outputPartialMethods=false,outputClientImpl=false -I ../api/proto ../api/proto/mountos_fs.proto",
    "gen:stubs": "cd ../gen && go run . -spec ../api/filesystem.yaml -client ../api/client.yaml -snapshot ../api/contract-snapshot.json -ts-out ../ts/src",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/client.test.js dist/test/bulk_watch.test.js dist/test/notices.test.js dist/test/reconnect.test.js dist/test/socketpath.test.js dist/test/pool.test.js dist/test/hostile.test.js dist/test/frame_fuzz.test.js dist/test/pipeline.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "ts-proto": "^2.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
